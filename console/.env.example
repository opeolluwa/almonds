# Base URL of the orchard API server (auth + REST endpoints)
SERVER_URL=http://localhost:5006

# Consumed by runtimeConfig.public.serverUrl and the Apollo httpEndpoint.
# For mobile dev on a physical device these must be this machine's LAN IP —
# `localhost` resolves to the phone, not to your dev machine.
NUXT_PUBLIC_SERVER_URL=http://localhost:8000
NUXT_PUBLIC_APOLLO_ENDPOINT=http://localhost:8000/orchard
